# ── Supabase (required) ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── App Auth (required) ──────────────────────────────
# Single API key that the frontend sends in X-API-Key header
API_SECRET_KEY=generate-a-long-random-string-here

# ── WhatsApp Webhook (required) ──────────────────────
# Must match the verify token you set in Meta Developer Console
WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── WhatsApp App Secret (required for webhook HMAC) ──
# Found in Meta App Dashboard → Settings → Basic → App Secret
META_APP_SECRET=your-meta-app-secret

# ── Optional overrides ───────────────────────────────
# Messages per second (default: 1). Max recommended: 80
SEND_RATE_PER_SECOND=1

# CORS origin for frontend (default: *)
FRONTEND_URL=https://your-app.vercel.app
